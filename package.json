    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/safe-regex": "^1.1.6",
    "@types/ws": "^8.18.0",
    "cross-env": "^10.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
