    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "undici": "^8.11.2",
    "update-notifier": "^7.3.1",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "xxhash-wasm": "^1.1.0",
    "yazl": "^3.3.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@atjsh/llmlingua-2": "3.0.0",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^13.0.3",
    "js-tiktoken": "^1.0.20",
    "keytar": "^7.9.0",
